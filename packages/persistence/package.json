{
  "name": "@agentlab/persistence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.config.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:reset": "tsx src/cli/reset.ts"
  },
  "dependencies": {
    "@agentlab/core": "workspace:*",
    "@langchain/core": "1.2.18",
    "@langchain/langgraph-checkpoint": "1.2.0",
    "@langchain/langgraph-checkpoint-postgres": "1.1.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
