#!/usr/bin/env bash
# Tercera barrera anti-atribución y formato de mensaje (ADR-006). Funciona también en commits manuales.
# Instalación: make setup  (= git config core.hooksPath .githooks)
msg_file="$1"
msg="$(cat "$msg_file")"

if printf '%s' "$msg" | grep -Eiq 'co-authored-by|generated with|generated by|claude|anthropic|🤖'; then
  echo "commit-msg: el mensaje contiene atribución a IA; está prohibida (docs/AGENTS.md §4, ADR-006)." >&2
  exit 1
fi

first="$(printf '%s\n' "$msg" | grep -v '^#' | head -n1)"
if ! printf '%s' "$first" | grep -Eq '^(feat|fix|test|docs|chore|refactor|ci|build)(\([a-z0-9-]+\))?!?: .{1,72}$'; then
  echo "commit-msg: la primera línea debe ser Conventional Commit: <type>(<scope>): <subject ≤ 72>" >&2
  echo "  recibido: $first" >&2
  exit 1
fi

if ! printf '%s' "$msg" | grep -Eq '^Task: (TASK-[0-9]{3}(-fix-[0-9]+)?|none)$'; then
  echo "commit-msg: falta el trailer 'Task: TASK-NNN' (o 'Task: none' solo para commits manuales de repositorio)." >&2
  exit 1
fi
exit 0
