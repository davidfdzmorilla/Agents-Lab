{
  "name": "agentlab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=1",
    "db:generate": "pnpm --filter @agentlab/persistence db:generate",
    "db:migrate": "pnpm --filter @agentlab/persistence db:migrate",
    "db:reset": "pnpm --filter @agentlab/persistence db:reset",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,js,json}\" \"*.{js,json}\" \"!packages/persistence/migrations/meta/**\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,tsx,js,json}\" \"*.{js,json}\" \"!packages/persistence/migrations/meta/**\""
  },
  "pnpm": {
    "overrides": {
      "msw>@inquirer/confirm": "6.3.5",
      "@inquirer/confirm>@inquirer/core": "12.0.6",
      "@inquirer/confirm>@inquirer/type": "4.2.1",
      "@inquirer/core>@inquirer/ansi": "2.0.10",
      "@inquirer/core>@inquirer/figures": "2.0.10",
      "@inquirer/core>@inquirer/type": "4.2.1",
      "msw>@mswjs/interceptors": "0.45.10",
      "msw>cookie": "2.0.1",
      "msw>tough-cookie": "6.0.2",
      "tough-cookie>tldts": "7.4.19",
      "tldts>tldts-core": "7.4.19",
      "headers-polyfill>set-cookie-parser": "3.2.1",
      "strip-ansi>ansi-regex": "6.4.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
