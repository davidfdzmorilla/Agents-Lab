# AgentLab — variables de entorno. Primer paso: cp .env.example .env y rellena los obligatorios antes de make up. NUNCA commitees .env.
# La sección "Compose" solo la lee docker compose; el resto se valida en packages/core/src/env.ts (una variable no declarada allí no existe).

# --- Compose (no pasan a env.ts) ---
POSTGRES_PASSWORD=                # obligatoria; solo [A-Za-z0-9]; la misma en las dos URLs de abajo

# --- Base de datos ---
DATABASE_URL=                     # obligatoria; postgresql://agentlab:<pw>@db:5432/agentlab (<pw> = POSTGRES_PASSWORD)
DATABASE_URL_TEST=                # obligatoria para make test; postgresql://agentlab:<pw>@db:5432/agentlab_test (solo la recibe el servicio test de compose; nunca web, worker ni migrate)

# --- Worker ---
WORKER_CONCURRENCY=1              # runs simultáneos por proceso worker (ADR-004)
WORKER_HEARTBEAT_MS=15000         # latido del worker; mismo valor en todos los workers que compartan base
WORKER_POLL_MS=1000               # sondeo del worker en reposo (ms)
WORKER_STALE_MS=60000             # heartbeat caducado → el worker marca el run failed, al arrancar y cada WORKER_STALE_MS (queued + reanudación desde TASK-026); debe ser mayor que WORKER_HEARTBEAT_MS; MISMO valor en todos los workers que compartan base (igual que WORKER_HEARTBEAT_MS): con valores distintos, el barrido del de umbral menor marca failed runs vivos de los otros
SHUTDOWN_GRACE_MS=30000           # espera máxima al run actual en SIGTERM; ≤ 35 s (stop_grace_period 40 s − margen 5 s)

# --- Proveedores (opcionales; el sistema arranca sin ninguno si hay Ollama) ---
# provider_configs.api_key_env guarda el NOMBRE de estas variables, nunca el valor.
OPENROUTER_API_KEY=               # https://openrouter.ai/keys — modelos :free sujetos a cuota
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey
OLLAMA_BASE_URL=http://ollama:11434/v1   # perfil local de Compose

# --- Tests ---
AGENTLAB_PROVIDER=fake            # fake | openai-compatible | gemini (los tests usan fake)

# --- Observabilidad (M3, opcional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=      # vacío = sin exportación
LOG_LEVEL=info                    # fatal | error | warn | info | debug | trace | silent
LANGCHAIN_TRACING_V2=false        # LangSmith off; no LANGCHAIN_API_KEY exists
