# AgentLab — variables de entorno. Copia a .env y rellena. NUNCA commitees .env.
# Todas se validan en packages/core/src/env.ts; una variable no declarada allí no existe.

# --- Base de datos ---
DATABASE_URL=postgresql://agentlab:agentlab@db:5432/agentlab          # conexión de web y worker (red interna de Compose)
DATABASE_URL_TEST=postgresql://agentlab:agentlab@localhost:5432/agentlab_test   # solo tests de integración

# --- Worker ---
WORKER_CONCURRENCY=1              # runs simultáneos por proceso worker (ADR-004)
WORKER_HEARTBEAT_MS=15000         # latido del worker
WORKER_STALE_MS=60000             # heartbeat caducado → run vuelve a queued
SHUTDOWN_GRACE_MS=30000           # espera máxima al run actual en SIGTERM

# --- Proveedores (opcionales; el sistema arranca sin ninguno si hay Ollama) ---
# provider_configs.api_key_env guarda el NOMBRE de estas variables, nunca el valor.
OPENROUTER_API_KEY=               # https://openrouter.ai/keys — modelos :free sujetos a cuota
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey
OLLAMA_BASE_URL=http://ollama:11434/v1   # perfil local de Compose

# --- Tests ---
AGENTLAB_PROVIDER=fake            # fake | openai-compatible | gemini (los tests usan fake)

# --- Observabilidad (M3, opcional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=      # vacío = sin exportación
LOG_LEVEL=info
